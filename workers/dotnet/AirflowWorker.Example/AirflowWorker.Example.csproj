<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AirflowWorker.Example</RootNamespace>
    <AssemblyName>AirflowWorker.Example</AssemblyName>
    <!-- Enable dynamic loading for plugins -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference contracts assembly - do NOT copy to output to prevent type identity issues -->
    <ProjectReference Include="..\AirflowWorker.Contracts\AirflowWorker.Contracts.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <!-- Optional: Add ML.NET for ML model scenarios -->
  <!-- Uncomment if you need ML model support -->
  <!--
  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="3.0.1" />
  </ItemGroup>
  -->

</Project>
