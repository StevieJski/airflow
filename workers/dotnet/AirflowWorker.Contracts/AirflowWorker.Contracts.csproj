<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AirflowWorker.Contracts</RootNamespace>
    <AssemblyName>AirflowWorker.Contracts</AssemblyName>

    <!-- Strong-name signing (cross-platform): use a local .snk file -->
    <SignAssembly>true</SignAssembly>
    <DelaySign>false</DelaySign>
    <AssemblyOriginatorKeyFile>Quantifi.snk</AssemblyOriginatorKeyFile>
    <PublicSign>false</PublicSign>

    <!-- NuGet Package Configuration -->
    <PackageId>AirflowWorker.Contracts</PackageId>
    <Version>1.0.4</Version>
    <Authors>Apache Airflow</Authors>
    <Description>Contracts and interfaces for implementing Apache Airflow worker tasks in .NET</Description>
    <PackageTags>airflow;worker;contracts</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/apache/airflow</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Generate package on build -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <!-- Include symbols for debugging -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>

  <!-- Do not include the private key in the NuGet package -->
  <ItemGroup>
    <None Include="Quantifi.snk" Pack="false" />
  </ItemGroup>

</Project>
