<Project>
  <PropertyGroup>
    <!-- Common properties for all projects in this directory -->
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- Assembly info -->
    <Company>Apache Software Foundation</Company>
    <Product>Apache Airflow - AWS Batch Worker Pool</Product>
    <Copyright>Copyright (c) Apache Software Foundation</Copyright>

    <!-- Package info -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/apache/airflow</PackageProjectUrl>
    <RepositoryUrl>https://github.com/apache/airflow</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
