# Environment variables for external AWS infrastructure testing.
# This file is sourced by run-external-infra-test.sh to pass variables to breeze.
#
# These are appended to _generated_docker_compose.env before running breeze tests.
# The ${VAR} syntax tells docker-compose to interpolate from the host environment.

# AWS Infrastructure
AWS_BATCH_JOB_DEFINITION=${AWS_BATCH_JOB_DEFINITION}
AWS_BATCH_JOB_QUEUE=${AWS_BATCH_JOB_QUEUE}
DOTNET_WORKER_IMAGE_URI=${DOTNET_WORKER_IMAGE_URI}
AIRFLOW_SHARED_STATE_S3_URI=${AIRFLOW_SHARED_STATE_S3_URI}
AIRFLOW_TASK_QUEUE_URL=${AIRFLOW_TASK_QUEUE_URL}
AIRFLOW_RESULT_QUEUE_URL=${AIRFLOW_RESULT_QUEUE_URL}

# Executor configuration for AwsBatchWorkerPoolExecutor
AIRFLOW__CORE__EXECUTOR=airflow.providers.amazon.aws.executors.batch.AwsBatchWorkerPoolExecutor
AIRFLOW__AWS_BATCH_WORKER_POOL_EXECUTOR__CONN_ID=aws_default
AIRFLOW__AWS_BATCH_WORKER_POOL_EXECUTOR__JOB_QUEUE=${AWS_BATCH_JOB_QUEUE}
AIRFLOW__AWS_BATCH_WORKER_POOL_EXECUTOR__JOB_DEFINITION=${AWS_BATCH_JOB_DEFINITION}
AIRFLOW__AWS_BATCH_WORKER_POOL_EXECUTOR__TASK_QUEUE_URL=${AIRFLOW_TASK_QUEUE_URL}
AIRFLOW__AWS_BATCH_WORKER_POOL_EXECUTOR__RESULT_QUEUE_URL=${AIRFLOW_RESULT_QUEUE_URL}
AIRFLOW__AWS_BATCH_WORKER_POOL_EXECUTOR__WORKER_IDLE_TIMEOUT_SECONDS=300
AIRFLOW__AWS_BATCH_WORKER_POOL_EXECUTOR__MIN_WORKERS=0
AIRFLOW__AWS_BATCH_WORKER_POOL_EXECUTOR__MAX_WORKERS=10
